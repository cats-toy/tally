  "blocks": [
    {
      "uuid": "b0000001-0000-0000-0000-000000000001",
      "type": "FORM_TITLE",
      "groupUuid": "b0000001-0000-0000-0000-000000000001",
      "groupType": "FORM_TITLE",
      "payload": {
        "html": "<strong>Your Financial Protection &amp; Investment Profile</strong>",
        "button": { "label": "Start survey" }
      }
    },

    {
      "uuid": "b0000002-0000-0000-0000-000000000002",
      "type": "TEXT",
      "groupUuid": "b0000002-0000-0000-0000-000000000002",
      "groupType": "TEXT",
      "payload": {
        "html": "<p>This short survey helps us understand your current situation and priorities — so we can have a meaningful conversation about your coverage and financial plans. Takes about 5 minutes.</p>"
      }
    },

    {
      "uuid": "b0000003-0000-0000-0000-000000000003",
      "type": "TITLE",
      "groupUuid": "b0000003-0000-0000-0000-000000000003",
      "groupType": "TITLE",
      "payload": {
        "html": "<strong>Part 1 — About You</strong>"
      }
    },

    {
      "uuid": "b0000010-0000-0000-0000-000000000010",
      "type": "MULTIPLE_CHOICE",
      "groupUuid": "b0000010-0000-0000-0000-000000000010",
      "groupType": "MULTIPLE_CHOICE",
      "payload": {
        "html": "<p>Which life stage best describes you right now?</p>",
        "options": [
          { "id": "opt-01-1", "text": "Single, starting out (20s–30s)" },
          { "id": "opt-01-2", "text": "Married, no children yet" },
          { "id": "opt-01-3", "text": "Young family (children under 12)" },
          { "id": "opt-01-4", "text": "Family with teens / older kids" },
          { "id": "opt-01-5", "text": "Pre-retiree (planning retirement in 1–10 years)" },
          { "id": "opt-01-6", "text": "Retired" }
        ],
        "hasOtherOption": false,
        "isMultiSelect": false
      }
    },

    {
      "uuid": "b0000011-0000-0000-0000-000000000011",
      "type": "MULTIPLE_CHOICE",
      "groupUuid": "b0000011-0000-0000-0000-000000000011",
      "groupType": "MULTIPLE_CHOICE",
      "payload": {
        "html": "<p>What is your approximate monthly household income (SGD)?</p>",
        "options": [
          { "id": "opt-02-1", "text": "Below $3,000" },
          { "id": "opt-02-2", "text": "$3,000 – $5,999" },
          { "id": "opt-02-3", "text": "$6,000 – $9,999" },
          { "id": "opt-02-4", "text": "$10,000 – $14,999" },
          { "id": "opt-02-5", "text": "$15,000 and above" },
          { "id": "opt-02-6", "text": "Prefer not to say" }
        ],
        "hasOtherOption": false,
        "isMultiSelect": false
      }
    },

    {
      "uuid": "b0000012-0000-0000-0000-000000000012",
      "type": "CHECKBOXES",
      "groupUuid": "b0000012-0000-0000-0000-000000000012",
      "groupType": "CHECKBOXES",
      "payload": {
        "html": "<p>What are your main financial responsibilities right now? <em>(Select all that apply)</em></p>",
        "options": [
          { "id": "opt-03-1", "text": "Supporting myself only" },
          { "id": "opt-03-2", "text": "Supporting a spouse / partner" },
          { "id": "opt-03-3", "text": "Raising children" },
          { "id": "opt-03-4", "text": "Supporting elderly parents" },
          { "id": "opt-03-5", "text": "Paying a mortgage / home loan" },
          { "id": "opt-03-6", "text": "Running a business" }
        ]
      }
    },

    {
      "uuid": "b0000020-0000-0000-0000-000000000020",
      "type": "TITLE",
      "groupUuid": "b0000020-0000-0000-0000-000000000020",
      "groupType": "TITLE",
      "payload": {
        "html": "<strong>Part 2 — Coverage Awareness</strong>"
      }
    },

    {
      "uuid": "b0000021-0000-0000-0000-000000000021",
      "type": "LINEAR_SCALE",
      "groupUuid": "b0000021-0000-0000-0000-000000000021",
      "groupType": "LINEAR_SCALE",
      "payload": {
        "html": "<p>How well do you feel you understand your existing insurance policies?</p>",
        "startValue": 1,
        "endValue": 5,
        "startLabel": "Not at all",
        "endLabel": "Very well"
      }
    },

    {
      "uuid": "b0000022-0000-0000-0000-000000000022",
      "type": "CHECKBOXES",
      "groupUuid": "b0000022-0000-0000-0000-000000000022",
      "groupType": "CHECKBOXES",
      "payload": {
        "html": "<p>Which types of insurance do you currently hold? <em>(Select all that apply)</em></p>",
        "options": [
          { "id": "opt-05-1", "text": "MediShield Life (mandatory)" },
          { "id": "opt-05-2", "text": "Integrated Shield Plan (IP)" },
          { "id": "opt-05-3", "text": "Life insurance (term or whole life)" },
          { "id": "opt-05-4", "text": "Critical illness cover" },
          { "id": "opt-05-5", "text": "Personal accident plan" },
          { "id": "opt-05-6", "text": "Investment-linked policy (ILP)" },
          { "id": "opt-05-7", "text": "Endowment / savings plan" },
          { "id": "opt-05-8", "text": "Not sure what I have" }
        ]
      }
    },

    {
      "uuid": "b0000023-0000-0000-0000-000000000023",
      "type": "MULTIPLE_CHOICE",
      "groupUuid": "b0000023-0000-0000-0000-000000000023",
      "groupType": "MULTIPLE_CHOICE",
      "payload": {
        "html": "<p>When did you last review your insurance coverage?</p>",
        "options": [
          { "id": "opt-06-1", "text": "Within the last 12 months" },
          { "id": "opt-06-2", "text": "1–3 years ago" },
          { "id": "opt-06-3", "text": "More than 3 years ago" },
          { "id": "opt-06-4", "text": "Never reviewed it" },
          { "id": "opt-06-5", "text": "Not sure" }
        ],
        "hasOtherOption": false,
        "isMultiSelect": false
      }
    },

    {
      "uuid": "b0000030-0000-0000-0000-000000000030",
      "type": "TITLE",
      "groupUuid": "b0000030-0000-0000-0000-000000000030",
      "groupType": "TITLE",
      "payload": {
        "html": "<strong>Part 3 — Attitudes &amp; Concerns</strong>"
      }
    },

    {
      "uuid": "b0000031-0000-0000-0000-000000000031",
      "type": "CHECKBOXES",
      "groupUuid": "b0000031-0000-0000-0000-000000000031",
      "groupType": "CHECKBOXES",
      "payload": {
        "html": "<p>Which financial risks concern you the most? <em>(Select up to 3)</em></p>",
        "options": [
          { "id": "opt-07-1", "text": "Serious illness or hospitalisation costs" },
          { "id": "opt-07-2", "text": "Not having enough savings for retirement" },
          { "id": "opt-07-3", "text": "Losing income due to disability or illness" },
          { "id": "opt-07-4", "text": "Leaving my family without financial support if I pass away" },
          { "id": "opt-07-5", "text": "Rising costs of living / inflation eating into savings" },
          { "id": "opt-07-6", "text": "Children's education expenses" },
          { "id": "opt-07-7", "text": "Eldercare costs for parents" }
        ]
      }
    },

    {
      "uuid": "b0000032-0000-0000-0000-000000000032",
      "type": "MULTIPLE_CHOICE",
      "groupUuid": "b0000032-0000-0000-0000-000000000032",
      "groupType": "MULTIPLE_CHOICE",
      "payload": {
        "html": "<p>How would you describe your attitude towards investing?</p>",
        "options": [
          { "id": "opt-08-1", "text": "Very conservative — I prefer low risk, stable returns" },
          { "id": "opt-08-2", "text": "Balanced — willing to accept some risk for moderate returns" },
          { "id": "opt-08-3", "text": "Growth-oriented — comfortable with market ups and downs" },
          { "id": "opt-08-4", "text": "Aggressive — seeking higher returns, high risk tolerance" },
          { "id": "opt-08-5", "text": "I haven't thought much about investing yet" }
        ],
        "hasOtherOption": false,
        "isMultiSelect": false
      }
    },

    {
      "uuid": "b0000033-0000-0000-0000-000000000033",
      "type": "LINEAR_SCALE",
      "groupUuid": "b0000033-0000-0000-0000-000000000033",
      "groupType": "LINEAR_SCALE",
      "payload": {
        "html": "<p>How satisfied are you with your current financial planning overall?</p>",
        "startValue": 1,
        "endValue": 5,
        "startLabel": "Very unsatisfied",
        "endLabel": "Very satisfied"
      }
    },

    {
      "uuid": "b0000040-0000-0000-0000-000000000040",
      "type": "TITLE",
      "groupUuid": "b0000040-0000-0000-0000-000000000040",
      "groupType": "TITLE",
      "payload": {
        "html": "<strong>Part 4 — Goals &amp; Gaps</strong>"
      }
    },

    {
      "uuid": "b0000041-0000-0000-0000-000000000041",
      "type": "CHECKBOXES",
      "groupUuid": "b0000041-0000-0000-0000-000000000041",
      "groupType": "CHECKBOXES",
      "payload": {
        "html": "<p>Are there areas where you feel your protection may be lacking? <em>(Select all that apply)</em></p>",
        "options": [
          { "id": "opt-10-1", "text": "Income replacement if I can't work" },
          { "id": "opt-10-2", "text": "Hospitalisation — worried about ward class or rider gaps" },
          { "id": "opt-10-3", "text": "Critical illness sum assured feels too low" },
          { "id": "opt-10-4", "text": "Life cover (death benefit) for my dependants" },
          { "id": "opt-10-5", "text": "Long-term care / disability in old age" },
          { "id": "opt-10-6", "text": "Retirement income — not sure CPF LIFE is enough" },
          { "id": "opt-10-7", "text": "I feel fairly well covered overall" }
        ]
      }
    },

    {
      "uuid": "b0000042-0000-0000-0000-000000000042",
      "type": "MULTIPLE_CHOICE",
      "groupUuid": "b0000042-0000-0000-0000-000000000042",
      "groupType": "MULTIPLE_CHOICE",
      "payload": {
        "html": "<p>What is your primary financial goal in the next 5 years?</p>",
