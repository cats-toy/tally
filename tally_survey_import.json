          { "id": "opt-12-1", "text": "Less than $200" },
          { "id": "opt-12-2", "text": "$200 – $499" },
          { "id": "opt-12-3", "text": "$500 – $999" },
          { "id": "opt-12-4", "text": "$1,000 – $1,999" },
          { "id": "opt-12-5", "text": "$2,000 and above" },
          { "id": "opt-12-6", "text": "Nothing at the moment" }
